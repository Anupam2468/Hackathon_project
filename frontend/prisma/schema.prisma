generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// CORE ENTITIES
// ============================================

model Hospital {
  id             String   @id @default(uuid()) @map("hospital_id")
  name           String
  location       String   @default("")
  latitude       Float?
  longitude      Float?
  verifiedBadge  Boolean  @default(false) @map("verified_badge")

  doctors        Doctor[]
  bloodStocks    BloodStock[]
  camps          Camp[]
  donations      Donation[]
  bloodRequests  BloodRequest[]

  @@map("hospitals")
}

model Doctor {
  id             String   @id @default(uuid()) @map("doctor_id")
  hospitalId     String   @map("hospital_id")
  hospital       Hospital @relation(fields: [hospitalId], references: [id])
  name           String
  verifiedBadge  Boolean  @default(false) @map("verified_badge")

  donations      Donation[]

  @@map("doctors")
}

model BloodStock {
  id              String   @id @default(uuid()) @map("stock_id")
  hospitalId      String   @map("hospital_id")
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  bloodGroup      String   @map("blood_group")
  unitsAvailable  Int      @map("units_available")

  @@map("blood_stocks")
}

model Camp {
  id          String   @id @default(uuid()) @map("camp_id")
  hospitalId  String   @map("hospital_id")
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  location    String
  campDate    DateTime @map("camp_date")

  @@map("camps")
}

// ============================================
// DONOR (with privacy-sensitive fields)
// ============================================

model Donor {
  id                 String    @id @default(uuid()) @map("donor_id")
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  bloodGroup         String    @map("blood_group")
  age                Int
  gender             String    @default("Male")
  phone              String
  whatsapp           String?
  address            String?
  latitude           Float?
  longitude          Float?
  weight             Float?
  verified           Boolean   @default(false)
  aiNotes            String?   @map("ai_notes")
  eligibilityStatus  String    @default("Eligible") @map("eligibility_status")
  lastDonationDate   DateTime? @map("last_donation_date")
  createdAt          DateTime  @default(now()) @map("created_at")

  healthQuestionnaires HealthQuestionnaire[]
  bloodRequests        BloodRequest[]
  notifications        Notification[]
  donations            Donation[]

  @@map("donors")
}

// ============================================
// PATIENT / RECIPIENT
// ============================================

model Patient {
  id             String         @id @default(uuid()) @map("patient_id")
  name           String
  contact        String
  bloodRequests  BloodRequest[]

  @@map("patients")
}

// ============================================
// TRANSACTIONS & RECORDS
// ============================================

model HealthQuestionnaire {
  id              String  @id @default(uuid()) @map("questionnaire_id")
  donorId         String  @map("donor_id")
  donor           Donor   @relation(fields: [donorId], references: [id])
  weight          Float
  age             Int
  medicalHistory  String  @map("medical_history")
  eligible        Boolean

  @@map("health_questionnaires")
}

model BloodRequest {
  id          String    @id @default(uuid()) @map("request_id")
  patientId   String?   @map("patient_id")
  patient     Patient?  @relation(fields: [patientId], references: [id])
  hospitalId  String?   @map("hospital_id")
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])
  donorId     String?   @map("donor_id")
  donor       Donor?    @relation(fields: [donorId], references: [id])
  bloodGroup  String    @map("blood_group")
  status      String    @default("pending")
  urgency     String    @default("Normal")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("blood_requests")
}

model Notification {
  id        String   @id @default(uuid()) @map("notification_id")
  donorId   String   @map("donor_id")
  donor     Donor    @relation(fields: [donorId], references: [id])
  type      String
  sentDate  DateTime @default(now()) @map("sent_date")

  @@map("notifications")
}

model Donation {
  id              String        @id @default(uuid()) @map("donation_id")
  donorId         String        @map("donor_id")
  donor           Donor         @relation(fields: [donorId], references: [id])
  hospitalId      String        @map("hospital_id")
  hospital        Hospital      @relation(fields: [hospitalId], references: [id])
  doctorId        String        @map("doctor_id")
  doctor          Doctor        @relation(fields: [doctorId], references: [id])
  donationDate    DateTime      @default(now()) @map("donation_date")
  labTestResult   String        @map("lab_test_result")
  status          String
  certificates    Certificate[]

  @@map("donations")
}

model Certificate {
  id             String   @id @default(uuid()) @map("certificate_id")
  donationId     String   @map("donation_id")
  donation       Donation @relation(fields: [donationId], references: [id])
  pdfUrl         String   @map("pdf_url")
  generatedDate  DateTime @default(now()) @map("generated_date")

  @@map("certificates")
}
